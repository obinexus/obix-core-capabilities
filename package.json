{
  "name": "obix-core-capabilities",
  "version": "0.5.0",
  "description": "Host identity, capability inspection and requirement checks for the OBIX CLI. Owns the shared compatibility host/result/error types. Zero deep host access at import time.",
  "license": "MIT",
  "author": "OBINexus Computing — Nnamdi Michael Okpala <okpalan@protonmail.com>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "docs",
    "README.md",
    "LICENSE",
    "test",
    "CHANGELOG.md",
    "PROVENANCE.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/*.test.mjs\""
  },
  "keywords": [
    "obix",
    "obix-core",
    "compatibility",
    "host",
    "capabilities"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obinexus/obix-core-capabilities.git"
  },
  "bugs": {
    "url": "https://github.com/obinexus/obix-core-capabilities/issues"
  },
  "homepage": "https://github.com/obinexus/obix-core-capabilities#readme"
}
